# ============================================================
# TenderWriter — Environment Variables
# Copy this file to .env and update values as needed
# ============================================================

# --- Application (REQUIRED) ---
APP_SECRET_KEY=your-secure-secret-key-min-32-chars
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Auth Provider ---
# AUTH_PROVIDER=legacy              # "legacy", "keycloak", or "hybrid"
# KEYCLOAK_URL=http://localhost:8180         # Browser/public URL exposed to frontend + issuer validation
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080 # Internal Docker URL for backend JWKS validation
# KEYCLOAK_REALM=tenderwriter
# KEYCLOAK_CLIENT_ID=tw-frontend    # Must match realm client for audience verification

# --- Admin (REQUIRED) ---
ADMIN_USERNAME=admin@admin.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_ENABLED=true

# --- PostgreSQL (REQUIRED) ---
POSTGRES_USER=tenderwriter
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=tenderwriter
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Qdrant (Vector DB) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Neo4j (Knowledge Graph - REQUIRED) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-neo4j-password

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=120

# --- Gateway (AI Router) ---
LLAMA_SERVER_URL=http://tw-gateway:8080/v1
GATEWAY_TIMEOUT=180
GATEWAY_TENDER_DMZ_UPSTREAM=http://llama-tender:8080
GATEWAY_OPENCODE_DMZ_UPSTREAM=http://llama-opencode:8080
GATEWAY_ANONYMIZER_URL=http://tw-anonymizer:8090
# Optional cloud fallback for tender route
GATEWAY_TENDER_CLOUD_PROVIDER=
GATEWAY_OPENAI_BASE_URL=https://api.openai.com
GATEWAY_OPENAI_API_KEY=
GATEWAY_ANTHROPIC_BASE_URL=https://api.anthropic.com
GATEWAY_ANTHROPIC_API_KEY=
# Dev mock for external LLM simulation:
# MOCK_EXTERNAL_LLM_PORT=18080
# GATEWAY_TENDER_CLOUD_PROVIDER=openai
# GATEWAY_OPENAI_BASE_URL=http://tw-mock-external-llm:18080
# GATEWAY_OPENAI_API_KEY=sk-mock
EXTERNAL_LLM_URL=
EXTERNAL_LLM_MODEL=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Re-Ranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- MinIO (Object Storage - REQUIRED) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-secure-minio-password
MINIO_BUCKET=tenderwriter
MINIO_CHAT_BUCKET=tenderwriter-chat
MINIO_SECURE=false

# --- Redis (Task Queue) ---
REDIS_URL=redis://redis:6379/0

# --- SMTP (Email 2FA - uses Mailpit in dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tenderwriter.ai
SMTP_TLS=false

# --- OnlyOffice (REQUIRED) ---
ONLYOFFICE_URL=http://localhost:8443
ONLYOFFICE_JWT_SECRET=your-secure-jwt-secret
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
BACKEND_PUBLIC_URL=http://tw-backend:8000

# --- KPI Reason Engine ---
KPI_REASON_ENGINE_PORT=8010
KPI_REASON_ENGINE_BASE_URL=http://tw-kpi-reason-engine:8010
KPI_REASON_ENGINE_SERVICE_TOKEN=changeme-kpi-service-token
KPI_REASON_ENGINE_TIMEOUT=10
KPI_REASON_ENGINE_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
KPI_REASON_ENGINE_DATABASE_SCHEMA=kpi_engine
KPI_REASON_ENGINE_DATABASE_PATH=/tmp/kpi_reason_engine.db
KPI_REASON_ENGINE_LEGACY_DATABASE_PATH=
KPI_REASON_ENGINE_AUTO_MIGRATE_LEGACY_ON_STARTUP=false
KPI_REASON_ENGINE_VALIDATE_LEGACY_MIGRATION=false

# --- Ops Agent ---
OPS_AGENT_BASE_URL=http://tw-ops-agent:8070
OPS_AGENT_TOKEN=your-secure-ops-agent-token
OPS_AGENT_TIMEOUT=5

# --- Frontend Auth Mode (Vite env vars) ---
# VITE_AUTH_MODE=legacy              # Optional fallback: "legacy", "keycloak", or "hybrid"
# VITE_KC_URL=http://localhost:8180  # Optional fallback Keycloak URL
# VITE_KC_REALM=tenderwriter
# VITE_KC_CLIENT_ID=tw-frontend

# --- Keycloak IAM (optional, profile: keycloak) ---
KC_IMAGE_TAG=26.1
KC_PORT=8180
KC_HOSTNAME=localhost
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=your-secure-keycloak-admin-password
KC_DB_USER=keycloak
KC_DB_PASSWORD=your-secure-keycloak-db-password
KC_DB_NAME=keycloak
KC_BOOTSTRAP_RETRIES=60
KC_BOOTSTRAP_DELAY_SECONDS=2
# Development users auto-seeded by the one-shot keycloak-bootstrap service
KC_TW_ADMIN_USERNAME=admin@admin.com
KC_TW_ADMIN_EMAIL=admin@admin.com
KC_TW_ADMIN_PASSWORD=TestPass123!
KC_TW_ADMIN_FIRST_NAME=System
KC_TW_ADMIN_LAST_NAME=Admin
KC_TW_EDITOR_USERNAME=registrazioni.hyperknow@gmail.com
KC_TW_EDITOR_EMAIL=registrazioni.hyperknow@gmail.com
KC_TW_EDITOR_PASSWORD=TestPass123!
KC_TW_EDITOR_FIRST_NAME=Massimo
KC_TW_EDITOR_LAST_NAME=Ferrara

# --- Mattermost / Video Collaboration (optional) ---
MM_IMAGE_TAG=10.11.8
MM_DBUSER=mmuser
MM_DBPASS=your-secure-mattermost-db-password
MM_DBNAME=mattermost
MM_PORT=8065
MM_SITE_URL=http://localhost:8065
MM_ADMIN_USER=tw-admin
MM_ADMIN_EMAIL=tw-admin@tenderwriter.local
MM_ADMIN_PASS=TW2026Secure!Pass
MM_TEAM_NAME=tenderwriter
MM_TEAM_DISPLAY_NAME=TenderWriter
MM_BOOTSTRAP_RETRIES=60
MM_BOOTSTRAP_DELAY_SECONDS=2
MM_EDITION=team
MM_TRANSCRIPT_WEBHOOK_URL=
MM_TRANSCRIPT_POLL_INTERVAL_SECONDS=5
MM_TRANSCRIPT_STABLE_SECONDS=20
# MM_EDITION=team       -> Mattermost Team/Community with TenderWriter OIDC plugin (default)
# MM_EDITION=enterprise -> Mattermost Enterprise/Entry with native OpenID Connect
# --- Mattermost OIDC / plugin switching ---
MM_OIDC_ENABLE=false
TW_OIDC_ENABLE=true
MM_OIDC_DISCOVERY_ENDPOINT=http://keycloak:8080/realms/tenderwriter/.well-known/openid-configuration
MM_OIDC_CLIENT_ID=mattermost
MM_OIDC_CLIENT_SECRET=CHANGE_ME_mattermost_client_secret
MM_OIDC_BUTTON_TEXT=Accedi con Keycloak
MM_OIDC_BUTTON_COLOR=#0058CC
TW_OIDC_PUBLIC_BASE_URL=http://localhost:8180
TW_OIDC_INTERNAL_BASE_URL=http://keycloak:8080
MM_LOGIN_REDIRECT_MODE=plugin

# Quick switch examples:
# Plugin OIDC (Team/Community, default)
# MM_EDITION=team
# MM_OIDC_ENABLE=false
# TW_OIDC_ENABLE=true
# MM_LOGIN_REDIRECT_MODE=plugin
#
# Native OIDC (Enterprise/Entry)
# MM_EDITION=enterprise
# MM_OIDC_ENABLE=true
# TW_OIDC_ENABLE=false
# MM_LOGIN_REDIRECT_MODE=off
# NOTE: for Enterprise native OIDC, prefer a hostname reachable by both browser
# and containers, e.g.:
# KC_HOSTNAME=host.docker.internal
# KEYCLOAK_URL=http://host.docker.internal:8180
# MM_OIDC_DISCOVERY_ENDPOINT=http://host.docker.internal:8180/realms/tenderwriter/.well-known/openid-configuration

# --- Jitsi Meet / Transcription (optional) ---
JITSI_IMAGE_TAG=stable-10741
JITSI_PUBLIC_URL=http://localhost:8880
JITSI_WEB_PORT=8880
JITSI_WEB_SSL_PORT=8843
JITSI_ENABLE_AUTH=0
JITSI_ENABLE_GUESTS=1
JITSI_ENABLE_TRANSCRIPTIONS=1
JITSI_JICOFO_COMPONENT_SECRET=change-this-jicofo-component-secret
JITSI_JICOFO_AUTH_PASSWORD=change-this-jicofo-auth-password
JITSI_JVB_AUTH_PASSWORD=change-this-jvb-auth-password
JITSI_JIGASI_XMPP_PASSWORD=change-this-jigasi-xmpp-password
JITSI_JIGASI_TRANSCRIBER_PASSWORD=change-this-jigasi-transcriber-password
JITSI_JVB_ADVERTISE_IPS=
JITSI_TRANSCRIBER_VOSK_URL=ws://vosk:2700
TZ=Europe/Rome

