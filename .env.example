# ============================================================
# TenderWriter — Environment Variables
# Copy this file to .env and update values as needed
# ============================================================

# --- Application (REQUIRED) ---
APP_SECRET_KEY=your-secure-secret-key-min-32-chars
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Admin (REQUIRED) ---
ADMIN_USERNAME=admin@admin.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_ENABLED=true

# --- PostgreSQL (REQUIRED) ---
POSTGRES_USER=tenderwriter
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=tenderwriter
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Qdrant (Vector DB) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Neo4j (Knowledge Graph - REQUIRED) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-neo4j-password

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=120

# --- Gateway (AI Router) ---
LLAMA_SERVER_URL=http://tw-gateway:8080/v1
GATEWAY_TENDER_DMZ_UPSTREAM=http://llama-tender:8080
GATEWAY_OPENCODE_DMZ_UPSTREAM=http://llama-opencode:8080
GATEWAY_ANONYMIZER_URL=http://tw-anonymizer:8090
# Optional cloud fallback for tender route
GATEWAY_TENDER_CLOUD_PROVIDER=
GATEWAY_OPENAI_BASE_URL=https://api.openai.com
GATEWAY_OPENAI_API_KEY=
GATEWAY_ANTHROPIC_BASE_URL=https://api.anthropic.com
GATEWAY_ANTHROPIC_API_KEY=
# Dev mock for external LLM simulation:
# MOCK_EXTERNAL_LLM_PORT=18080
# GATEWAY_TENDER_CLOUD_PROVIDER=openai
# GATEWAY_OPENAI_BASE_URL=http://tw-mock-external-llm:18080
# GATEWAY_OPENAI_API_KEY=sk-mock
EXTERNAL_LLM_URL=
EXTERNAL_LLM_MODEL=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Re-Ranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- MinIO (Object Storage - REQUIRED) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-secure-minio-password
MINIO_BUCKET=tenderwriter
MINIO_CHAT_BUCKET=tenderwriter-chat
MINIO_SECURE=false

# --- Redis (Task Queue) ---
REDIS_URL=redis://redis:6379/0

# --- SMTP (Email 2FA - uses Mailpit in dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tenderwriter.ai
SMTP_TLS=false

# --- OnlyOffice (REQUIRED) ---
ONLYOFFICE_URL=http://localhost:8443
ONLYOFFICE_JWT_SECRET=your-secure-jwt-secret
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
BACKEND_PUBLIC_URL=http://tw-backend:8000

# --- KPI Reason Engine ---
KPI_REASON_ENGINE_PORT=8010
KPI_REASON_ENGINE_BASE_URL=http://tw-kpi-reason-engine:8010
KPI_REASON_ENGINE_SERVICE_TOKEN=changeme-kpi-service-token
KPI_REASON_ENGINE_TIMEOUT=10
KPI_REASON_ENGINE_DATABASE_PATH=/app/data/kpi_reason_engine.db

# --- Ops Agent ---
OPS_AGENT_BASE_URL=http://tw-ops-agent:8070
OPS_AGENT_TOKEN=your-secure-ops-agent-token
OPS_AGENT_TIMEOUT=5
